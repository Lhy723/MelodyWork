{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MelodyWork",
  "version": "0.3.0",
  "identifier": "dev.lhy723.melodywork",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "node scripts/prepare-sidecar.mjs && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MelodyWork",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "hiddenTitle": true,
        "titleBarStyle": "Overlay",
        "decorations": true,
        "trafficLightPosition": {
          "x": 16,
          "y": 26
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: https: data: blob:; font-src 'self' asset: data:; connect-src 'self' ipc: http://ipc.localhost http://localhost:1420 ws://localhost:1420 https:; worker-src 'self' blob:; child-src 'self' blob:; frame-src 'self' https:; object-src 'none'; base-uri 'self'; form-action 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/melody-pager"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQzQkFCQjFCM0U0MTU5RkEKUldUNldVRStHN3U2MDF4dWs2NUozald3NlZVUHdCN041K3o1M0ZRQmVja3B6Rm9OVzkxYk1zNkEK"
    }
  }
}
